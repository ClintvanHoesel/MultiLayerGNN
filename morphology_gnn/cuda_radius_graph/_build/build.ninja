ninja_required_version = 1.3
cxx = /home/clint/miniforge3/envs/pyt/bin/x86_64-conda-linux-gnu-c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=morphology_gnn_cuda_radius_graph -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1016\" -isystem /home/clint/miniforge3/envs/pyt/lib/python3.13/site-packages/torch/include -isystem /home/clint/miniforge3/envs/pyt/lib/python3.13/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /home/clint/miniforge3/envs/pyt/include/python3.13 -D_GLIBCXX_USE_CXX11_ABI=1 -fPIC -std=c++17
post_cflags = 
cuda_cflags = -ccbin /home/clint/miniforge3/envs/pyt/bin/x86_64-conda-linux-gnu-cc -DTORCH_EXTENSION_NAME=morphology_gnn_cuda_radius_graph -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1016\" -isystem /home/clint/miniforge3/envs/pyt/lib/python3.13/site-packages/torch/include -isystem /home/clint/miniforge3/envs/pyt/lib/python3.13/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /home/clint/miniforge3/envs/pyt/include/python3.13 -D_GLIBCXX_USE_CXX11_ABI=1 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_120,code=compute_120 -gencode=arch=compute_120,code=sm_120 --compiler-options '-fPIC' -O3 -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/home/clint/miniforge3/envs/pyt/lib/python3.13/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build radius_graph.o: compile /home/clint/MultiLayerGNN/morphology_gnn/cuda_radius_graph/radius_graph.cpp
build radius_graph_kernel.cuda.o: cuda_compile /home/clint/MultiLayerGNN/morphology_gnn/cuda_radius_graph/radius_graph_kernel.cu





build morphology_gnn_cuda_radius_graph.so: link radius_graph.o radius_graph_kernel.cuda.o

default morphology_gnn_cuda_radius_graph.so
