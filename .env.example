# Copy this file to `.env` (git-ignored) and fill in your keys.
# Never commit real keys — `.env` is excluded by .gitignore.

# Weights & Biases.
# Either set this here, OR run `wandb login` once (it stores the key in
# ~/.netrc, outside the repo). The runner (runs/run_training.py) checks
# WANDB_API_KEY, then .env, then ~/.netrc automatically.
WANDB_API_KEY=

# Other keys your scripts may need (examples):
# OPENAI_API_KEY=
# HUGGINGFACE_TOKEN=
